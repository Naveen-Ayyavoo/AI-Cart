# ==============================================================================
# TrustCart Environment Configuration Template
# DO NOT COMMIT REAL CREDENTIALS. Copy this file to .env for local development.
# ==============================================================================

# --- Django Settings ---
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Google Gemini API (via Google AI Studio) ---
# Untrusted reasoning component; produces structured purchase proposals
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Channel3 Product Data API ---
# Product discovery & live market evidence (USD, US Market)
CHANNEL3_API_KEY=your_channel3_api_key_here
CHANNEL3_BASE_URL=https://api.channel3.com/v1

# --- PayPal Orders API (Sandbox) ---
# Payment execution; isolated server-side capture against demo payee
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here
PAYPAL_DEMO_MERCHANT_ID=your_demo_merchant_account_id_here

# --- Application Security & Policy Defaults ---
TRUSTCART_APPROVAL_TTL_SECONDS=900
TRUSTCART_MAX_DISCREPANCY_PERCENT=0.00

